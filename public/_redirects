/tools/json-pretty/ /tools/json-formatter 301
/tools/json-viewer /tools/json-formatter 301
/tools/json-viewer/ /tools/json-formatter 301
/tools/url-encoder-decoder /tools/url-encoder 301
/tools/url-encoder-decoder/ /tools/url-encoder 301
